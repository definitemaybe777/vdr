[Unit]
Description=vdrd coredump socket daemon
Documentation=https://github.com/definitemaybe777/vdr
After=local-fs.target
ConditionKernelVersion=>=6.16

# The crash socket belongs to vdrd.socket: systemd creates it and keeps it
# alive regardless of this daemon's state. Waiting for it only orders vdrd
# start, so crashes never depend on this unit having started.
Requires=vdrd.socket
After=vdrd.socket

[Service]
Type=simple
ExecStart=/usr/bin/vdrd

Environment=RUST_LOG=info
Restart=on-failure
RestartSec=1
TimeoutStartSec=10

# vdrd drains up to MAX_CONCURRENT_DUMPS (4) in-flight dumps before
# exiting. A large core (up to 2 GB) through zstd plus fsync can
# outlast the default stop timeout of 90 s; being SIGKILLed mid-dump
# leaves a half-written .core.*.tmp orphan, which vdrd removes on the
# next startup (see cleanup_stale_temp_files).
TimeoutStopSec=300

# core_pattern is applied declaratively from sysctl.d at boot, so this unit
# performs no runtime kernel writes and needs no cleanup on shutdown.
# Resource limits
MemoryMax=256M

# pids.max counts every thread: the accept thread plus up to 4 dump
# workers. At 4 the fourth spawn fails with EAGAIN and that dump is
# dropped, so leave headroom above 1 + MAX_CONCURRENT_DUMPS.
TasksMax=8

OOMScoreAdjust=500

# Directories
StateDirectory=vdr
StateDirectoryMode=0700

# /run/vdr belongs to vdrd.socket (DirectoryMode=0700 creates it at
# bind time). A RuntimeDirectory here would make systemd delete the
# directory — and the socket file inside it — every time this
# service stops, leaving the socket unit listening on an unlinked path.

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
Nice=9

# Not used:
#   PrivateDevices, ProtectKernelLogs — vdrd writes logs to /dev/kmsg
#   ProtectKernelTunables — would block the sysctl write even with +

[Install]
WantedBy=multi-user.target
