[Unit]
Description=vdrd coredump socket daemon
Documentation=https://github.com/definitemaybe0/vdr
After=local-fs.target
ConditionKernelVersion=>=6.16

# The crash socket belongs to vdrd.socket: systemd creates it and keeps it
# alive regardless of this daemon's state. Waiting for it only orders vdrd
# start, so crashes never depend on this unit having started.
Requires=vdrd.socket
After=vdrd.socket

[Service]
Type=simple
ExecStart=/usr/bin/vdrd

Environment=RUST_LOG=info
Restart=on-failure
RestartSec=1
TimeoutStartSec=10

# core_pattern is applied declaratively from sysctl.d at boot, so this unit
# performs no runtime kernel writes and needs no cleanup on shutdown.
# Resource limits
MemoryMax=256M
TasksMax=4
OOMScoreAdjust=500

# Directories
StateDirectory=vdr
StateDirectoryMode=0700

# /run/vdr belongs to vdrd.socket (DirectoryMode=0700 creates it at
# bind time). A RuntimeDirectory here would make systemd delete the
# directory — and the socket file inside it — every time this
# service stops, leaving the socket unit listening on an unlinked path.

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
Nice=9

# Not used:
#   PrivateDevices, ProtectKernelLogs — vdrd writes logs to /dev/kmsg
#   ProtectKernelTunables — would block the sysctl write even with +

[Install]
WantedBy=multi-user.target
