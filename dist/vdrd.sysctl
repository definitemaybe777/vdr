# vdrd coredump socket daemon — kernel parameters
#
# Applied by systemd-sysctl.service at boot. These settings are
# kernel-wide and must be active before vdrd starts.
#
# core_pattern itself is set by vdrd.service via ExecStartPost,
# because the socket must exist before the kernel can use it.

# Keep crashed processes alive until the coredump handler finishes
# collecting metadata from /proc/<pid>/. The kernel default is 0
# (don't wait), which means the crashing task may be reaped before
# vdrd can read /proc/<pid>/exe and pidfd credentials.
#
# A non-zero value enables the COREDUMP_WAIT flag, causing the kernel
# to hold the crashing task alive until vdrd closes the connection.
# For pipe mode, the value also limits concurrent helpers; for socket
# mode, concurrency is bounded by the accept queue backlog.
kernel.core_pipe_limit=16

# Allow core dumps from SUID/SGID binaries. Mode 2 (suidsafe)
# allows SUID/SGID processes to be dumped; without this setting,
# the kernel silently skips them. vdrd enforces 0600 root-only on
# all stored cores regardless of this setting.
fs.suid_dumpable=2
